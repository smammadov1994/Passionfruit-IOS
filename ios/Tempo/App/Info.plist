<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(TEMPO_BRAND_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>$(TEMPO_BRAND_NAME) adds a date to your calendar when you ask a match's agent to. It never reads your calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>$(TEMPO_BRAND_NAME) uses your camera for live video dates. Frames from your own camera are checked automatically to keep dates safe.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>$(TEMPO_BRAND_NAME) uses your location once to show your city and to find people near you.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>$(TEMPO_BRAND_NAME) uses your microphone so the person you are on a date with can hear you.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>$(TEMPO_BRAND_NAME) transcribes what you say on this device during dates and checks the text to keep dates free of sexual harassment. Audio never leaves your phone for this.</string>
	<key>TempoAPIBaseURL</key>
	<string>$(TEMPO_API_BASE_URL)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
