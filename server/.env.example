# ---- Core ----
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Public origin of this API, used to build photo URLs with the local blob store.
PUBLIC_BASE_URL=http://localhost:8080
# Set to 1 when running behind a load balancer / reverse proxy (uses X-Forwarded-For for rate limits).
TRUST_PROXY=0
# CORS is off unless this is set (comma-separated origins). The native app does not need it.
CORS_ORIGIN=

# ---- Auth ----
# REQUIRED. At least 32 random characters: `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL_DAYS=30
APPLE_BUNDLE_ID=com.seymur.passionfruit
# DEV ONLY. Both are refused when NODE_ENV=production.
ALLOW_DEV_AUTH=1
ALLOW_DEV_IAP=1

# ---- In-app purchase verification ----
# Path to Apple Root CA - G3 (DER .cer or PEM). Required in production. See README.
APPLE_ROOT_CA_PATH=
# Optional: SHA-256 fingerprint the file must have (hex, colons allowed).
APPLE_ROOT_CA_SHA256=

# ---- Persistence ----
# Unset = in-memory store (dev only; data is lost on restart).
DATABASE_URL=
DATABASE_SSL=0
DATABASE_POOL_MAX=10
# Certificate authority file for hosts that sign their own certificates (Supabase: Database
# settings > SSL configuration > download certificate). Leave empty otherwise.
DATABASE_SSL_CA_PATH=

# ---- Photo storage ----
BLOB_STORE=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Product tunables (served by GET /v1/config) ----
DATE_DURATION_SEC=120
TURN_DURATION_SEC=30
DECISION_WINDOW_SEC=20
# After the first question the date pauses and both people privately vote to carry on or stop.
# Seconds they get; no answer counts as stop. 0 turns this checkpoint off.
CHECKPOINT_WINDOW_SEC=10
FREE_DAILY_DATES=5
FRAME_SAMPLE_INTERVAL_SEC=3
# ---- Server-side timing ----
READY_TIMEOUT_SEC=8
RECONNECT_GRACE_SEC=6
DECISION_GRACE_MS=1000
QUEUE_STATUS_INTERVAL_SEC=5
# Share of pairings that ignore the compatibility score and pick a random compatible partner,
# so new people get dates and the score keeps learning. 0 = always the best-scoring partner.
MATCH_EXPLORE_RATE=0.1
REPAIR_COOLDOWN_HOURS=24
WS_IDLE_TIMEOUT_SEC=45
STRIKES_TO_SUSPEND=3

# ---- WebRTC ICE ----
STUN_URLS=stun:stun.l.google.com:19302
# coturn with `use-auth-secret`; credentials are minted per user and expire after TURN_TTL_SEC.
TURN_URLS=
TURN_SECRET=
TURN_TTL_SEC=3600

# ---- Moderation ----
# mock = deterministic dev provider. http = real vision vendor (see README "Moderation vendor").
MODERATION_PROVIDER=mock
MODERATION_API_URL=
MODERATION_API_KEY=
MODERATION_NUDITY_THRESHOLD=0.85
MODERATION_TIMEOUT_MS=4000

# ---- Push ----
# noop = log nothing, send nothing. apns = Apple Push Notification service.
PUSH_PROVIDER=noop
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
# 1 = api.push.apple.com, 0 = sandbox
APNS_PRODUCTION=0
PUSH_SCHEDULER_INTERVAL_SEC=300
PUSH_MIN_INTERVAL_HOURS=4
PUSH_MIN_COMPATIBLE=3
PUSH_LOCAL_HOUR_START=9
PUSH_LOCAL_HOUR_END=23
QUESTIONS_PER_DATE=0
MATCH_ON_FULL_DATE=1
